# Leadflow Backend — environment variables
# Copy this file to `.env`, fill in real values, then run `npm run dev`.
# Required for all features unless marked optional. Never commit the real `.env`.

# ---- Database (Turso / libSQL) -----
# REQUIRED — the hosted Turso database connection and auth token.
# Point the local CLI at the file data/leadflow.db or a hosted Turso DB URL.
# Get these from https://turso.tech (database + token) or a local turso instance.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_access_token

# ---- AI (OpenAI-compatible gateway) ----
# REQUIRED for AI Chat, Email, WhatsApp, Call, and Image features.
# baseURL must point at an OpenAI-compatible endpoint.
#   Direct OpenAI:            https://api.openai.com/v1
#   OpenRouter:               https://openrouter.ai/api/v1
AI_API_KEY=sk-your-api-key
AI_BASE_URL=https://api.openai.com/v1

# OPTIONAL — text model used by chat/email/whatsapp/call (default shown).
AI_MODEL=openai/gpt-5.6-luna

# OPTIONAL — image model used by the Creative Studio (default: gpt-image-2).
# Must be supported by the gateway at {AI_BASE_URL}/images/generations.
AI_IMAGE_MODEL=gpt-image-2

# ---- AgentMail (real email send/receive in Email Studio) ----
# REQUIRED for the real send + inbox sync features. The inbox is the AgentMail
# address emails are sent from and received at.
# Get a key at https://console.agentmail.to (keys start with am_).
AGENTMAIL_API_KEY=am_your_api_key
AGENTMAIL_INBOX=you@agentmail.to

# OPTIONAL — AgentMail API base URL (default shown).
AGENTMAIL_API_BASE=https://api.agentmail.to/v0

# ---- WhatsApp (Meta Cloud API / RelayX bridge) ----
# Phase 2 inbound + outbound. Provider shape follows the Meta WhatsApp Cloud
# API; RelayX (https://whatssapi.vercel.app) and similar bridges expose the same
# webhook + /{phone-id}/messages contract. All of these are OPTIONAL — WhatsApp
# features simply stay inert until set.
#
# OPTIONAL — enables sending. A Meta system-user access token, or the bridge key.
WHATSAPP_API_TOKEN=
# OPTIONAL — the phone-number-id for the sending number on Meta Cloud API.
WHATSAPP_PHONE_ID=
# OPTIONAL — base URL for the send endpoint (defaults to Meta Graph v21.0).
# For RelayX-style bridges, point this at their API base.
WHATSAPP_API_BASE=https://graph.facebook.com/v21.0
# OPTIONAL — the sending WhatsApp number in E.164 form (e.g. 15551234567).
WHATSAPP_FROM_NUMBER=
# OPTIONAL — token that must match hub.verify_token during the GET webhook
# handshake. Register this URL in the provider console.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# OPTIONAL — a shared secret sent as the x-webhook-secret header by the provider
# (or X-Hub-Signature-256). When set, inbound POSTs are rejected without it.
WHATSAPP_WEBHOOK_SECRET=
# OPTIONAL — off-hours acknowledgement window (24h "HH:MM" in a named tz).
WHATSAPP_WORKING_HOURS_START=09:00
WHATSAPP_WORKING_HOURS_END=18:00
WHATSAPP_WORKING_TZ=America/New_York

# ---- Phase 0 — Conversation SLA ----
# OPTIONAL — how long a human/AI has to respond to an inbound message before
# the conversation-level SLA "breaches" (default 4 hours). Powers alerting.
SLA_RESPONSE_HOURS=4

# ---- Server / CORS ----
# OPTIONAL — extra allowed CORS origins, comma-separated. The dev origins
# (localhost:5173, localhost:3000) and the Hostinger frontend are always allowed.
CORS_ORIGINS=https://example.com,https://elsewhere.example.com

# OPTIONAL — HTTP port for local dev server (default 3001). Matches the
# Vite dev proxy target in Frontend-Leads/vite.config.ts.
PORT=3001

# OPTIONAL — "development" starts the local listener; "production" runs
# serverless (no listener) for Vercel.
NODE_ENV=development
